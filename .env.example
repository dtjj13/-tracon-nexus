# Server-only GraphHopper credentials. Never expose this key to the browser.
GRAPHHOPPER_API_KEY=

# Confirm the production profile with GraphHopper before public release.
GRAPHHOPPER_PROFILE=truck

# MapTiler browser key. Restrict it to approved Tracon domains in MapTiler.
NEXT_PUBLIC_MAPTILER_API_KEY=

# Existing integrations used by Tracon Nexus.
EIA_API_KEY=
OPENAI_API_KEY=
